{
	"name": "umbodsmadr",
	"version": "0.0.6",
	"private": true,
	"type": "module",
	"description": "The arbiter of policy within the autonomous realm.",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run packages/cli/src/cli.ts start",
		"start": "bun run packages/cli/src/cli.ts start",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"build": "bun build ./packages/cli/src/cli.ts --compile --outfile dist/umbod",
		"build:win": "bun build ./packages/cli/src/cli.ts --compile --target=bun-windows-x64 --outfile dist/umbod.exe",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"bump": "bumpp --quiet"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"devDependencies": {
		"bun-types": "1.3.14",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"bumpp": "11.0.1",
		"oxfmt": "0.44.0",
		"oxlint": "1.59.0"
	}
}
